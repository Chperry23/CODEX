  -H "Content-Type: application/json" \
  -H "X-API-Key: your-api-key" \
  -d '{
    "key_id": "api_test_key",
    "master_password": "secure-password",
    "metadata": {"description": "API test key"}
  }'

# Retrieving a key
curl -X POST http://localhost:5000/api/keys/api_test_key/retrieve \
  -H "Content-Type: application/json" \
  -H "X-API-Key: your-api-key" \
